# Backend Dockerfile - Production ready
# Use a single-stage build to keep it simple and reliable

FROM node:21-alpine

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy source code
COPY . ./

# Create .env if it doesn't exist
RUN echo "NODE_ENV=production" > .env && \
    echo "PORT=5000" >> .env

# Expose the port specified in the env or default to 5000
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "const http = require('http'); const options = { host: 'localhost', port: process.env.PORT || 5000, path: '/' }; http.get(options, res => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Start the application
CMD ["node", "server.js"]